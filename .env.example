# Copie para .env  ->  cp .env.example .env
# Nenhum valor real/sensivel deve ser commitado.

APP_ENV=development
APP_DEBUG=true

# --- Postgres ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_password
POSTGRES_DB=erp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth / JWT ---
# Em producao isso vem de um secrets manager (AWS Secrets Manager / SSM), nunca do .env
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Cache ---
CACHE_TTL_SECONDS=60
